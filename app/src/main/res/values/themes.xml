<resources>
    <style name="Theme.BibleQuickSearchKJV" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.BibleQuickSearchKJV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/kjv_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.BibleQuickSearchKJV</item>
    </style>
</resources>
